{
  "name": "@kyc-rip/nkip-0001",
  "version": "0.1.0",
  "description": "Reference implementation of NKIP-0001 (Verifiable Deposit Receipts): signed receipts, salted commitments, Nostr attestation witnessing, and XMR salt_box / NIP-44 salt recovery.",
  "keywords": [
    "nkip",
    "nkip-0001",
    "monero",
    "xmr",
    "nostr",
    "ed25519",
    "verifiable-receipt",
    "non-kyc",
    "swap"
  ],
  "license": "MIT",
  "author": "kyc.rip",
  "homepage": "https://nkips.org/nkip-0001/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KYC-rip/nkip-0001.git"
  },
  "bugs": {
    "url": "https://github.com/KYC-rip/nkip-0001/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "peerDependencies": {
    "@noble/curves": ">=1.4.0",
    "@noble/hashes": ">=1.4.0",
    "nostr-tools": ">=2.7.0"
  },
  "peerDependenciesMeta": {
    "nostr-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.0.0",
    "@types/node": "^22.20.5",
    "nostr-tools": "^2.10.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
